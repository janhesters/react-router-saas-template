{
  "name": "reactsquad-react-router-saas-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run typegen && react-router build",
    "check": "bun run fix:lint && bun run fix:format",
    "check:format": "oxfmt --check .",
    "check:lint": "bun run typegen && oxlint .",
    "check:shadcn": "bun scripts/check-shadcn-lint.ts",
    "dev": "bun run typegen:prisma && react-router dev",
    "dev:mocks": "EMAIL_MOCKS=true MOCKS=true bun scripts/run-with-test-database.ts bun run dev",
    "fix:format": "oxfmt --write .",
    "fix:lint": "bun run typegen && oxlint --fix .",
    "lint": "bun run check:lint && bun run check:shadcn && bun run check:format",
    "prepare": "husky",
    "prisma:deploy": "bunx prisma migrate deploy",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:migrate:init": "bunx prisma migrate dev --name init && bun run typegen:prisma",
    "prisma:push": "bunx prisma db push && bun run typegen:prisma",
    "prisma:seed": "bun ./prisma/seed.ts",
    "prisma:studio": "bunx prisma studio",
    "quickstart": "bun run setup:env && bun run test:db:reset && bun run test:db:seed && bun run dev:mocks",
    "setup:env": "bun scripts/setup-env.ts",
    "start": "react-router-serve ./build/server/index.js",
    "stripe:resend-events": "bun scripts/resend-stripe-events.ts",
    "test": "bun scripts/run-with-test-database.ts bunx vitest --reporter=verbose --run",
    "test:db:reset": "bun scripts/run-with-test-database.ts bunx prisma db push --force-reset",
    "test:db:seed": "bun scripts/run-with-test-database.ts bun ./prisma/seed.ts",
    "test:e2e": "bun scripts/run-with-test-database.ts bunx playwright test",
    "test:e2e:ui": "bun scripts/run-with-test-database.ts bunx playwright test --ui",
    "test:watch": "bun scripts/run-with-test-database.ts bunx vitest --reporter=verbose",
    "typecheck": "bun run typegen && tsc",
    "typegen": "bun run typegen:router && bun run typegen:prisma",
    "typegen:prisma": "DATABASE_URL=postgresql://prisma:prisma@localhost:5432/prisma bunx prisma generate",
    "typegen:router": "react-router typegen",
    "validate": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/lib-storage": "3.1132.0",
    "@aws-sdk/s3-request-presigner": "3.1132.0",
    "@base-ui/react": "1.8.0",
    "@conform-to/react": "1.21.1",
    "@conform-to/zod": "1.21.1",
    "@epic-web/client-hints": "1.3.9",
    "@epic-web/invariant": "1.0.0",
    "@nichtsam/helmet": "0.3.3",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "@react-email/components": "1.0.12",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@remix-run/form-data-parser": "0.17.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-table": "9.2.4",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cobe": "2.0.1",
    "copy-to-clipboard": "4.0.2",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-fetch-backend": "8.0.0",
    "input-otp": "1.5.0",
    "isbot": "5.2.2",
    "motion": "13.3.0",
    "pg": "8.23.0",
    "pretty-cache-header": "1.0.0",
    "prisma": "7.10.0",
    "ramda": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14",
    "react-icons": "5.7.0",
    "react-router": "8.3.1",
    "remix-i18next": "8.0.0",
    "remix-utils": "10.0.0",
    "sonner": "2.0.8",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@react-router/remix-routes-option-adapter": "8.3.1",
    "@rolldown/plugin-transform-imports": "0.1.1",
    "@shadcn/lint": "0.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/ramda": "0.32.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-perfectionist": "5.11.0",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "msw": "2.15.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-router-devtools": "6.2.3",
    "remix-flat-routes": "0.8.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,json5,css,scss,less,md,mdx,html,yml,yaml,toml}": [
      "oxfmt --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "bun@1.4.0"
}
